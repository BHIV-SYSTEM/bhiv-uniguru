# Backend
UNIGURU_HOST=0.0.0.0
UNIGURU_PORT=8000
UNIGURU_WORKERS=1
UNIGURU_LOG_LEVEL=INFO
UNIGURU_API_AUTH_REQUIRED=false
UNIGURU_API_TOKEN=replace-me
UNIGURU_API_TOKENS=replace-me
UNIGURU_ALLOWED_CALLERS=*
UNIGURU_RATE_LIMIT_WINDOW_SECONDS=60
UNIGURU_RATE_LIMIT_MAX_REQUESTS=100
UNIGURU_ROUTER_QUEUE_LIMIT=200
UNIGURU_ROUTER_LATENCY_THRESHOLD_MS=1200
UNIGURU_ROUTER_CIRCUIT_OPEN_SECONDS=30
UNIGURU_ROUTER_UNVERIFIED_FALLBACK=false
UNIGURU_LANGUAGE_ADAPTER_ENABLED=true
UNIGURU_LANGUAGE_ADAPTER_DEFAULT_LANGUAGE=en
UNIGURU_BUCKET_TELEMETRY_ENABLED=false
UNIGURU_CORE_READER_ENABLED=false
UNIGURU_EMBEDDING_MODEL=all-MiniLM-L6-v2
EXTERNAL_API_SECRET_KEY=replace-me

# Optional integrations
UNIGURU_ENGINE_URL=
UNIGURU_BRIDGE_URL=
UNIGURU_LLM_URL=
UNIGURU_LLM_MODEL=llama3
UNIGURU_LLM_TIMEOUT_SECONDS=20
TANTRA_SDK_ENABLED=false
TANTRA_SDK_BASE_URL=
TANTRA_SDK_TOKEN=
INSIGHT_CORE_URL=
INSIGHT_CORE_CLIENT_ID=
INSIGHT_CORE_CLIENT_SECRET=
INSIGHT_BRIDGE_URL=
INSIGHT_BRIDGE_TIMEOUT_SECONDS=5.0
INSIGHTFLOW_ENABLED=false
INSIGHTFLOW_BASE_URL=
INSIGHTFLOW_ENDPOINT=
INSIGHTFLOW_TOKEN=
GC_ENABLED=false
GC_ENDPOINT=
MDU_ENABLED=false
MDU_API_KEY=

# Production public port
UNIGURU_HTTP_PORT=8026

# Vite build-time values: set these to the browser-visible public origin
VITE_API_BASE_URL=http://localhost:8020
VITE_API_URL=http://localhost:8020
VITE_SANSKRIT_API_URL=http://localhost:8020
VITE_BACKEND_URL_V1=http://localhost:8020/api/v1
VITE_APP__BACKEND_GOOGLE_OAUTH_URL=http://localhost:8020/auth/google/token
VITE_GOOGLE_CLIENT_ID=
